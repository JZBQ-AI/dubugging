/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
    model = "BioZ Watch MDBT50Q-1MV2";
    compatible = "bioz,watch";
    aliases { watchdog0 = &wdt0; };
    zephyr,user {
        led-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
        mux-disable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
        /* Order: EL1, EL2B, EL3B, EL4; each A0, A1, A2. */
        mux-address-gpios = <&gpio0 23 0>, <&gpio0 20 0>, <&gpio0 21 0>,
                            <&gpio0 7 0>, <&gpio0 5 0>, <&gpio0 26 0>,
                            <&gpio0 19 0>, <&gpio0 17 0>, <&gpio0 15 0>,
                            <&gpio0 16 0>, <&gpio0 14 0>, <&gpio0 13 0>;
        afe-int-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        afe-trig-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
        battery-alert-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
        charger-pgood-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        charger-chg-gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
&pinctrl {
    bioz_spi_default: bioz_spi_default {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
                         <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                         <NRF_PSEL(SPIM_MISO, 0, 6)>; };
    };
    bioz_spi_sleep: bioz_spi_sleep {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
                         <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                         <NRF_PSEL(SPIM_MISO, 0, 6)>; low-power-enable; };
    };
    bioz_i2c_default: bioz_i2c_default {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 25)>,
                         <NRF_PSEL(TWIM_SCL, 0, 24)>; };
    };
    bioz_i2c_sleep: bioz_i2c_sleep {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 25)>,
                         <NRF_PSEL(TWIM_SCL, 0, 24)>; low-power-enable; };
    };
};
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };
&uicr { gpio-as-nreset; };
/* VDD and VDDH both 1.8V. Do not inherit DK regulator or peripheral pins. */
&reg1 { regulator-initial-mode = <NRF5X_REG_MODE_LDO>; };
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&bioz_spi_default>;
    pinctrl-1 = <&bioz_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
    //afe: afe@0 { compatible = "vnd,spi-device"; reg = <0>; spi-max-frequency = <1000000>; };
};
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <100000>;
    pinctrl-0 = <&bioz_i2c_default>;
    pinctrl-1 = <&bioz_i2c_sleep>;
    pinctrl-names = "default", "sleep";
};
